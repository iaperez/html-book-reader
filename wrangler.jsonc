{
  // Cloudflare Worker that serves the generated static site.
  // "Connect to Git" builds the repo with `node publish.js` and this Worker
  // serves everything in dist/ as static assets — no server code needed.
  //
  // The site is served at  https://<name>.<your-subdomain>.workers.dev
  // (attach a custom domain later from the Worker's Settings → Domains).
  "name": "biblioteca-abierta",
  "compatibility_date": "2025-06-01",
  // publish.js writes the finished, self-contained HTML here.
  "assets": {
    "directory": "./dist"
  }
}
